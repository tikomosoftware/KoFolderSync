<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- アプリケーションアイコン -->
    <ApplicationIcon>Resources\app-icon.ico</ApplicationIcon>
    
    <!-- アプリケーション情報 -->
    <AssemblyTitle>KoFolderSync</AssemblyTitle>
    <Product>KoFolderSync</Product>
    <Company>tikomo software</Company>
    <Copyright>Copyright © 2026 tikomo software</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Version>1.0.0</Version>
    <Description>シンプルで使いやすいフォルダ同期アプリケーション</Description>
    
    <!-- MS Store用の設定 -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- PublishSingleFile設定 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\app-icon.ico" />
  </ItemGroup>

</Project>
